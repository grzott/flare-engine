{
  "name": "flare-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Modular 2D engine for React Native + Web — animation, gamification, interactive UI, and games, built on Skia",
  "license": "Apache-2.0",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git"
  },
  "keywords": ["flare-engine", "2d", "react-native", "web", "skia", "monorepo"],
  "workspaces": ["packages/*", "benchmarks", "apps/*"],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome check .",
    "typecheck": "turbo typecheck",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json",
    "check:deps": "bun scripts/check-deps-tiers.mjs",
    "check:peers": "bun scripts/check-peer-completeness.mjs",
    "check:tarballs": "bun scripts/audit-tarballs.mjs --selftest && bun scripts/audit-tarballs.mjs --head-only",
    "check:history": "bun scripts/scan-history.mjs",
    "check:changeset": "bun scripts/check-changeset.mjs",
    "check:changeset-symbols": "bun scripts/check-changeset-symbols.mjs",
    "check:bump": "bun scripts/check-bump-level.mjs",
    "check:exports": "bun scripts/check-exports.mjs",
    "check:nodenext": "bun scripts/check-nodenext.mjs",
    "check:publish-safety": "bun scripts/check-publish-safety.mjs",
    "check:readme": "bun scripts/check-readme-snippets.mjs",
    "check:perf": "bun scripts/check-perf.mjs",
    "check:perf-bytes": "bun scripts/check-perf.mjs --bytes",
    "check:perf-freshness": "bun scripts/check-perf-freshness.mjs",
    "check:audit": "bun audit",
    "deps:outdated": "bun outdated --recursive",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "bench": "turbo bench",
    "bench:pinned": "turbo bench:pinned",
    "bench:baseline": "turbo bench:baseline",
    "bench:promote": "turbo bench:promote",
    "bench:md": "turbo bench:md",
    "bench:web": "turbo bench:web",
    "bench:web:gpu": "turbo bench:web:gpu",
    "bench:web:android": "turbo bench:web:android",
    "bench:web:promote": "turbo bench:web:promote --",
    "propagate-license": "bun run scripts/propagate-license.ts",
    "prebuild": "bun run propagate-license",
    "changeset": "changeset",
    "version": "bun run check:bump && changeset version && bun run scripts/concretize-workspace-deps.ts && bun install",
    "release": "bun run propagate-license && turbo build --filter='./packages/*' && bun run check:publish-safety && bun run check:perf && bun run check:perf-freshness && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@biomejs/biome": "^2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.4",
    "turbo": "^2.0.0",
    "typescript": "^7.0",
    "unrun": "^0.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": ["biome check --write --no-errors-on-unmatched"]
  },
  "overrides": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "trustedDependencies": ["@shopify/react-native-skia"],
  "packageManager": "bun@1.3.11"
}
