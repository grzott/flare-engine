{
  "name": "@flare-engine/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic World factory, fake Clock, mock InputManager, and scene snapshot helpers",
  "keywords": ["flare-engine", "testing", "ecs", "fake-clock", "snapshot"],
  "license": "MIT",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git",
    "directory": "packages/testing"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flare-engine/core": "workspace:*",
    "@flare-engine/ecs": "workspace:*",
    "@flare-engine/input": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
