{
  "name": "@flare-engine-apps/bench-web",
  "version": "0.0.0",
  "private": true,
  "description": "Headless CanvasKit runner for the render microbench suite, driven by Playwright",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/server.ts",
    "bench:web": "bun run scripts/run.ts",
    "bench:web:gpu": "BENCH_WEB_MODE=gpu bun run scripts/run.ts",
    "lint": "biome check src/ scripts/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@flare-engine/benchmarks": "workspace:*",
    "@flare-engine/postfx": "workspace:*",
    "@flare-engine/render": "workspace:*",
    "@flare-engine/render-web": "workspace:*",
    "@flare-engine/testing": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "canvaskit-wasm": "^0.40.0",
    "playwright": "1.62.1",
    "typescript": "^5.9"
  }
}
