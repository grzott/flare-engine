{
  "name": "@flare-engine/errors",
  "version": "0.4.3",
  "description": "React error boundary, structured crash payload, pluggable crash transport",
  "keywords": ["flare-engine", "errors", "error-boundary", "crash-report", "sentry"],
  "license": "Apache-2.0",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git",
    "directory": "packages/errors"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsdown",
    "test": "bun ../../scripts/test-isolated.mjs",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "@sentry/react-native": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/react-native": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
