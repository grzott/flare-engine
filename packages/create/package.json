{
  "name": "@flare-engine/create",
  "version": "0.4.2",
  "description": "One-shot scaffolder for Flare engine apps — `npm create @flare-engine`",
  "keywords": ["flare-engine", "scaffold", "create-app", "expo", "react-native"],
  "license": "Apache-2.0",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git",
    "directory": "packages/create"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "flare-create": "dist/bin.js"
  },
  "files": ["dist", "templates", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.templates.json"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@flare-engine/ecs": "^0.4.2",
    "@flare-engine/engine": "^0.4.2",
    "@flare-engine/physics": "^0.4.2",
    "@flare-engine/react": "^0.4.2",
    "@flare-engine/render": "^0.4.2",
    "@flare-engine/tilemap": "^0.4.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
