{
  "name": "@flare-engine/iap-revenuecat",
  "version": "0.4.5",
  "description": "RevenueCat IAPProvider adapter for @flare-engine/iap",
  "keywords": ["flare-engine", "iap", "revenuecat", "in-app-purchase", "adapter"],
  "license": "Apache-2.0",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git",
    "directory": "packages/iap-revenuecat"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsdown",
    "test": "bun ../../scripts/test-isolated.mjs",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flare-engine/iap": "^0.4.5"
  },
  "peerDependencies": {
    "react-native": ">=0.79.0",
    "react-native-purchases": ">=8.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
