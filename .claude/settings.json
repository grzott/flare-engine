{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun test*)",
      "Bash(bun run build*)",
      "Bash(bun run lint*)",
      "Bash(bun run typecheck*)",
      "Bash(bun install*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(bun --bun test tests/skia-bridge.test.ts)",
      "Bash(grep -l \"@flare-engine/render\\\\|flashIntensity\" c:/_PROG/flare-engine/packages/react/tests/*.ts)",
      "Bash(bunx biome *)",
      "Bash(bun --version)",
      "Bash(bun -e \"import { flashIntensity } from '@flare-engine/render'; console.log\\(typeof flashIntensity\\)\")",
      "Bash(bun run *)",
      "Bash(bun -e \"import\\('@flare-engine/render'\\).then\\(m => console.log\\('flashIntensity:', typeof m.flashIntensity\\)\\)\")",
      "Bash(grep -n \"from '@flare-engine/input'\" src/*.tsx src/*.ts tests/*.ts)",
      "Bash(find /c/_PROG/flare-engine/packages -name \"CLAUDE.md\" -exec echo \"=== {} ===\" \\\\; -exec head -30 {} \\\\;)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ],
    "defaultMode": "acceptEdits"
  }
}
