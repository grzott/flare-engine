{
  "name": "flare-engine",
  "private": true,
  "workspaces": ["packages/*", "benchmarks", "apps/*"],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "bench": "bun run --cwd benchmarks bench",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "bun-types": "^1.3.12",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": ["biome check --write"]
  },
  "overrides": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "trustedDependencies": ["@shopify/react-native-skia"],
  "packageManager": "bun@1.2.0"
}
