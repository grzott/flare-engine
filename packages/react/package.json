{
  "name": "@flare-engine/react",
  "version": "0.0.0",
  "private": true,
  "description": "GameView, hooks, VirtualJoystick, VirtualButton",
  "keywords": ["flare-engine", "react", "react-native", "game-view", "hooks"],
  "license": "MIT",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git",
    "directory": "packages/react"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.0.0"
  },
  "dependencies": {
    "@flare-engine/assets": "workspace:*",
    "@flare-engine/audio": "workspace:*",
    "@flare-engine/core": "workspace:*",
    "@flare-engine/ecs": "workspace:*",
    "@flare-engine/input": "workspace:*",
    "@flare-engine/render": "workspace:*",
    "@flare-engine/scene": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "@shopify/react-native-skia": ">=1.0.0",
    "react-native-gesture-handler": ">=2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
