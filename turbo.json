{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.json", "biome.json", "bunfig.toml"],
  "globalPassThroughEnv": ["FLARE_PERF_ALLOW_STALE", "FLARE_PERF_BASE_REF"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "@flare-engine-apps/bench-dashboard#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**"],
      "inputs": [
        "app/**",
        "package.json",
        "tsconfig.json",
        "next.config.ts",
        "postcss.config.mjs",
        "$TURBO_ROOT$/benchmarks/results/microbench.json",
        "$TURBO_ROOT$/benchmarks/results/device.json"
      ],
      "env": ["DEPLOY"]
    },
    "@flare-engine/benchmarks#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "results/**"]
    },
    "@flare-engine/benchmarks#bench:promote": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@flare-engine/benchmarks#bench": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["FLARE_BENCH_NO_RECORD"]
    },
    "@flare-engine/benchmarks#bench:baseline": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@flare-engine/benchmarks#bench:md": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["FLARE_BENCH_ALLOW_STALE"]
    },
    "@flare-engine-apps/bench-web#bench:web": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
