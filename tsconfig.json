{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "types": ["bun"]
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "packages/*/tsdown.config.ts",
    "scripts/**/*.ts"
  ],
  // `scripts/readme-snippets/` is generated by check-readme-snippets.mjs and
  // gitignored, and it deliberately contains a broken `__liveness__.ts` canary
  // proving that checker can still detect an error. Compiling it here would make
  // this gate pass or fail depending on whether check:readme had been run.
  "exclude": ["node_modules", "dist", "scripts/readme-snippets"]
}
