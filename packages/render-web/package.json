{
  "name": "@flare-engine/render-web",
  "version": "0.2.0",
  "description": "CanvasKit-backed web renderer for @flare-engine/render frame-renderer",
  "keywords": ["flare-engine", "rendering", "web", "canvaskit", "wasm"],
  "license": "MIT",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git",
    "directory": "packages/render-web"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flare-engine/render": "^0.2.0",
    "@flare-engine/postfx": "^0.2.0"
  },
  "peerDependencies": {
    "canvaskit-wasm": ">=0.40.0"
  },
  "peerDependenciesMeta": {
    "canvaskit-wasm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
