{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.json", "biome.json", "bunfig.toml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "@flare-engine/benchmarks#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json"]
    },
    "@flare-engine/benchmarks#bench:promote": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@flare-engine/benchmarks#bench": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["FLARE_BENCH_NO_RECORD"]
    },
    "@flare-engine/benchmarks#bench:baseline": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@flare-engine/benchmarks#bench:md": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["FLARE_BENCH_ALLOW_STALE"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
