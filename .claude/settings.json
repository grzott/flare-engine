{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run lint:*)",
      "Bash(bun run lint)",
      "Bash(bun run typecheck:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run test:*)",
      "Bash(bun run test)",
      "Bash(bun run build:*)",
      "Bash(bun run build)",
      "Bash(bun --cwd:*)",
      "Bash(bun test:*)",
      "Bash(bun test)",
      "Bash(bunx turbo:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Read(**)",
      "Edit(packages/**)",
      "Edit(apps/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(CLAUDE.md)",
      "Edit(SESSION_LOG.md)",
      "Write(packages/**)",
      "Write(apps/**)",
      "Write(docs/**)",
      "Write(.claude/**)",
      "Write(.github/**)",
      "Write(CLAUDE.md)",
      "Write(SESSION_LOG.md)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)",
      "Bash(rm -rf:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Edit(bun.lock)",
      "Edit(.husky/**)",
      "Write(bun.lock)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/session-start.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/pre-bash-guard.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/post-edit-lint.sh" }]
      }
    ]
  }
}
