{
  "name": "flare-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Modular 2D engine for React Native + Web — animation, gamification, interactive UI, and games, built on Skia",
  "license": "MIT",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git"
  },
  "keywords": ["flare-engine", "2d", "react-native", "web", "skia", "monorepo"],
  "workspaces": ["packages/*", "benchmarks", "apps/*"],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome check .",
    "typecheck": "turbo typecheck",
    "check:deps": "bun scripts/check-deps-tiers.mjs",
    "check:changeset": "bun scripts/check-changeset.mjs",
    "check:exports": "bun scripts/check-exports.mjs",
    "check:nodenext": "bun scripts/check-nodenext.mjs",
    "check:publish-safety": "bun scripts/check-publish-safety.mjs",
    "check:audit": "bun audit",
    "deps:outdated": "bun outdated --recursive",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "bench": "bun run --cwd benchmarks bench",
    "propagate-license": "bun run scripts/propagate-license.ts",
    "prebuild": "bun run propagate-license",
    "changeset": "changeset",
    "version": "changeset version && bun run scripts/concretize-workspace-deps.ts && bun install",
    "release": "bun run propagate-license && turbo build --filter='./packages/*' && bun run check:publish-safety && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@biomejs/biome": "^2",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.4",
    "turbo": "^2.0.0",
    "typescript": "^5.9",
    "unrun": "^0.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": ["biome check --write"]
  },
  "overrides": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "trustedDependencies": ["@shopify/react-native-skia"],
  "packageManager": "bun@1.3.11"
}
