{
  "name": "@flare-engine/tilemap",
  "version": "0.4.1",
  "description": "Tiled/LDtk parser, culled tilemap renderer",
  "keywords": ["flare-engine", "tilemap", "tiled", "ldtk"],
  "license": "Apache-2.0",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git",
    "directory": "packages/tilemap"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsdown",
    "test": "bun ../../scripts/test-isolated.mjs",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flare-engine/assets": "^0.4.1",
    "@flare-engine/math": "^0.4.1",
    "@flare-engine/physics": "^0.4.1",
    "@flare-engine/render": "^0.4.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
