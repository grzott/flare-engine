node_modules/
dist/
.turbo/
.next/
out/
coverage/
*.tsbuildinfo
bun.lockb
.DS_Store
# Visual reference deck (HTML+CSS+JS+concept art) — kept local, not committed.
# README.md and the canonical PNG folios are whitelisted so the visual source-of-truth ships.
docs/references/pan-tvardowski/*
!docs/references/pan-tvardowski/README.md
!docs/references/pan-tvardowski/folios/
!docs/references/pan-tvardowski/folios/**

# Expo CNG — native folders are regenerated by `expo prebuild`.
# All native customization belongs in app.json or config plugins
# (see apps/demo/plugins/ when one is needed).
apps/*/android/
apps/*/ios/
apps/*/.expo/

# JetBrains IDE local config
.idea/

# /start batch state — per-row diff baseline consumed by verify.sh
.claude/.batch-baseline

# nodenext exports-map probe — regenerated from the live package list by
# scripts/check-nodenext.mjs on every run; never committed.
scripts/nodenext-probe/probe.generated.mts

# README snippet-compile scratch — virtual snippet files + generated tsconfig
# regenerated from every packages/*/README.md by scripts/check-readme-snippets.mjs
# on every run; never committed.
scripts/readme-snippets/

# TestingBot credentials — real values never committed; see .env.testingbot.example
apps/*/.env.testingbot

# TestingBot per-run artifacts persisted by bench-cloud.sh for CI inspection.
# Uploaded as GH Actions artifact, not committed.
perf-artifacts/

# EAS local build artifacts (downloaded APK/IPA for smoke runs)
apps/*/build-*.apk
apps/*/build-*.ipa

# Owner-local publish + env credentials — never committed (root-anchored so the
# apps-level .env.testingbot.example template is never shadowed).
/.npmrc
/.env*

# Private planning notes + audit ledgers (business-sensitive; never committed).
# OSS-A0 formalizes this; added early 2026-07-05 to protect the deep-audit ledger.
docs/plans/_local/

