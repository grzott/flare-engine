{
  "name": "@flare-engine/engine",
  "version": "0.4.0",
  "description": "Flare Engine umbrella — curated barrel (14 headless packages + postfx + react); ./headless subpath for web-only and Node consumers",
  "keywords": ["flare-engine", "2d", "react-native", "web", "skia"],
  "license": "Apache-2.0",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git",
    "directory": "packages/engine"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.mts",
        "default": "./dist/headless.mjs"
      },
      "require": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flare-engine/math": "^0.4.0",
    "@flare-engine/events": "^0.4.0",
    "@flare-engine/core": "^0.4.0",
    "@flare-engine/dynamics": "^0.4.0",
    "@flare-engine/ecs": "^0.4.0",
    "@flare-engine/render": "^0.4.0",
    "@flare-engine/input": "^0.4.0",
    "@flare-engine/physics": "^0.4.0",
    "@flare-engine/audio": "^0.4.0",
    "@flare-engine/assets": "^0.4.0",
    "@flare-engine/scene": "^0.4.0",
    "@flare-engine/animation": "^0.4.0",
    "@flare-engine/particles": "^0.4.0",
    "@flare-engine/tilemap": "^0.4.0",
    "@flare-engine/debug": "^0.4.0",
    "@flare-engine/postfx": "^0.4.0",
    "@flare-engine/react": "^0.4.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "@shopify/react-native-skia": ">=2.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.7.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-audio-api": ">=0.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
