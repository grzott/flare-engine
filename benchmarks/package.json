{
  "name": "@flare-engine/benchmarks",
  "version": "0.0.0",
  "private": true,
  "description": "Off-device microbenchmarks for Flare engine hot paths",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "bench:web:promote": "bun src/web-promote-cli.ts",
    "bench": "bun run src/index.ts",
    "bench:pinned": "bun scripts/bench-pinned.mjs",
    "bench:baseline": "bun run src/index.ts --write-baseline",
    "bench:promote": "bun run src/index.ts --promote",
    "bench:md": "bun run src/index.ts --markdown",
    "test": "bun test",
    "lint": "biome check src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./results/microbench.json": "./results/microbench.json",
    "./results/device.json": "./results/device.json",
    "./results/web.json": "./results/web.json",
    "./results/web-gpu.json": "./results/web-gpu.json",
    "./results/web-android.json": "./results/web-android.json",
    "./scenarios": "./src/scenarios/index.ts",
    "./harness": "./src/harness.ts",
    "./scenario-contract": "./src/scenario-contract.ts",
    "./power": "./src/power.ts",
    "./affinity": "./src/affinity.ts"
  },
  "dependencies": {
    "@flare-engine/core": "workspace:*",
    "@flare-engine/ecs": "workspace:*",
    "@flare-engine/particles": "workspace:*",
    "@flare-engine/physics": "workspace:*",
    "@flare-engine/render": "workspace:*",
    "@flare-engine/testing": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
