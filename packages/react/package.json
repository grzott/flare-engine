{
  "name": "@flare-engine/react",
  "version": "0.2.1",
  "description": "GameView, hooks, VirtualJoystick, VirtualButton",
  "keywords": ["flare-engine", "react", "react-native", "game-view", "hooks"],
  "license": "MIT",
  "author": "Grzegorz Otto",
  "homepage": "https://github.com/grzott/flare-engine#readme",
  "bugs": {
    "url": "https://github.com/grzott/flare-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzott/flare-engine.git",
    "directory": "packages/react"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  },
  "dependencies": {
    "@flare-engine/assets": "^0.2.1",
    "@flare-engine/audio": "^0.2.1",
    "@flare-engine/core": "^0.2.1",
    "@flare-engine/ecs": "^0.2.1",
    "@flare-engine/events": "^0.2.1",
    "@flare-engine/input": "^0.2.1",
    "@flare-engine/math": "^0.2.1",
    "@flare-engine/render": "^0.2.1",
    "@flare-engine/scene": "^0.2.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "@shopify/react-native-skia": ">=2.0.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
