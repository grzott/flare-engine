# .env.testingbot.example — template for TestingBot cloud smoke runner.
#
# Copy to .env.testingbot and fill in the real values. The real file is gitignored.
# The script (scripts/run-smoke-cloud.sh) auto-loads this file via `set -a; source`,
# so plain KEY=value syntax is fine — no `export`, no manual `source` step.
#
# Run from anywhere:
#   cd apps/pan-tvardowski && bun run smoke:cloud:android
#
# Vars are consumed by scripts/run-smoke-cloud.sh.

# TestingBot API key.
# Obtain from: testingbot.com → User settings → API key + secret.
# Format: alphanumeric string, e.g. abc123def456
TESTINGBOT_KEY=""

# TestingBot API secret (paired with TESTINGBOT_KEY).
# Obtain from: same User settings page as the key.
# Format: alphanumeric string.
TESTINGBOT_SECRET=""

# Absolute or relative path to the release Android APK.
# Local build: eas build --profile preview --platform android --local (macOS/Linux only).
# On Windows: eas build --profile preview --platform android (cloud build), then
#   download the APK from the Application Archive URL via curl/browser.
# Format: path ending in .apk, e.g. ./build-1234567890.apk
APK_PATH=""

# Absolute or relative path to the release iOS IPA.
# Local build: eas build --profile preview --platform ios --local (macOS only).
# On Windows: eas build --profile preview --platform ios (cloud build, no --local flag),
#   then download IPA. Requires Apple Developer account.
# Format: path ending in .ipa, e.g. ./build-1234567890.ipa
IPA_PATH=""

# TTI threshold in milliseconds (default 3000 if unset).
# Raise only with architect sign-off; do not paper over a real perf regression.
# Format: integer, e.g. 3000
# TTI_THRESHOLD_MS=3000
